# 虚拟环境（各自独立，不进版本库）
.venv/

# 密钥：只提交 .env.example
.env

# 运行产物
data/
logs/
*.db
*.db.bak-*

# 缓存
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
build/
dist/
*.egg-info/

# 工具运行态（自动任务记忆等本机数据，不入库）
.workbuddy/

# Docker 构建资产：Camoufox 离线内核包约 1.3 GB，不进仓库
# 放置方法与命名规则见 docs/deployment.md 第三节
.docker-assets/camoufox-*.zip
.docker-assets/*.tar.*
