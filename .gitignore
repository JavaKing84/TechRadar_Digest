# 虚拟环境（各自独立，不进版本库）
.venv/

# 密钥：只提交 .env.example
.env

# 运行产物
data/
logs/
*.db
*.db.bak-*

# 缓存
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
build/
dist/
*.egg-info/

# 工具运行态（自动任务记忆等本机数据，不入库）
.workbuddy/

# 运维迁移留档：从其他目录挪过来的旧 compose / 配置备份，只在本机与服务器存在
_legacy/

# Camoufox 内核包与指纹模型（约 1.3 GB，不进仓库）
camoufox-*.zip
fpgen-model-release.zip
kernel_full.zip
.docker-assets/camoufox-*.zip
.docker-assets/*.tar.*
# 分片下载的临时片段（多段 range 并发下载时产生）
.docker-assets/dlparts/
