# =====================================================================
# news_ai_science · 环境变量模板
# 用法：cp .env.example .env 后填值；代码启动时自动读 .env
# 优先级：环境变量 > .env > config/config.yaml
# =====================================================================

# ---- 大模型（OpenAI 兼容协议）----
# 默认走 DeepSeek 官方 API；base_url / model 已在 config/config.yaml 里写好，
# 正常情况下只需填 Key。要用别家（或私有部署 qwen）时改下面两项即可，
# 关思考的请求体写法会按 base_url 自动切换，不用改代码。
DEEPSEEK_API_KEY=
# 通用名别名，二者等效，同名项 DEEPSEEK_* 优先
# LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# [可选] 覆盖关思考的写法：auto / deepseek / vllm / none
# LLM_THINKING_OFF_STYLE=auto

# ---- 飞书群机器人（本项目专属，不要与 news_ai_job 共用）----
# 注意：webhook 里的 token 等价于密码，别提交进公开仓库
FEISHU_WEBHOOK_URL=
# 群机器人开了「加签」才填，免签留空
FEISHU_WEBHOOK_SECRET=

# ---- 飞书自建应用（卡片配图上传 img_key 必需，缺了卡片会无图）----
FEISHU_APP_ID=
FEISHU_APP_SECRET=
