# =====================================================================
# news_ai_science · 环境变量模板
# 用法：cp .env.example .env 后填值；代码启动时自动读 .env
# 优先级：环境变量 > .env > config/config.yaml
# =====================================================================

# ---- 大模型（OpenAI 兼容协议）----
LLM_BASE_URL=http://59.65.232.180:18000/v1
LLM_API_KEY=
LLM_MODEL=qwen3.6-35b-a3b

# ---- 飞书群机器人（本项目专属，不要与 news_ai_job 共用）----
# 注意：webhook 里的 token 等价于密码，别提交进公开仓库
FEISHU_WEBHOOK_URL=
# 群机器人开了「加签」才填，免签留空
FEISHU_WEBHOOK_SECRET=

# ---- 飞书自建应用（本机器人当前不用图，留空即可）----
FEISHU_APP_ID=
FEISHU_APP_SECRET=
